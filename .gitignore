# Credentials and per-machine configuration
.env
.env.*
!.env.example
*.local.toml
*.local.csv
auth.json
.agents/
.codex/
.claude/
.zcode/

# Case data: only the self-authored example inputs are distributable.
/cases/*
!/cases/case_0001/
/cases/case_0001/*
!/cases/case_0001/README.md
!/cases/case_0001/input/
!/cases/case_0001/source/
/cases/case_0001/input/*
!/cases/case_0001/input/commit_message.txt
!/cases/case_0001/input/diff.txt
/cases/case_0001/source/*
!/cases/case_0001/source/example.c

# Only the minimal prompt snapshot, provenance and optional placeholders.
/third_party/*
!/third_party/README.md
!/third_party/sashiko/
/third_party/sashiko/*
!/third_party/sashiko/LICENSE
!/third_party/sashiko/third_party/
/third_party/sashiko/third_party/*
!/third_party/sashiko/third_party/prompts/
/third_party/sashiko/third_party/prompts/*
!/third_party/sashiko/third_party/prompts/LICENSE
!/third_party/sashiko/third_party/prompts/README.md
!/third_party/sashiko/third_party/prompts/REVISION
