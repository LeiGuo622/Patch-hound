# Copy this file to .env and provide your own values. Never commit .env.
# Optional history tool: use a separately maintained Linux checkout.
LINUX_REPO_PATH=/path/to/linux

# Optional API providers. Account-based default configurations use local login.
PATCHHOUND_DEEPSEEK_API_KEY=
PATCHHOUND_NEWAPI_BASE_URL=https://api.example.invalid/v1
PATCHHOUND_GLM_CODING_API_KEY=
PATCHHOUND_GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
PATCHHOUND_DGX_API_KEY=
PATCHHOUND_DGX_BASE_URL=http://127.0.0.1:8000/v1

# Optional tracing.
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=
PHOENIX_API_KEY=
