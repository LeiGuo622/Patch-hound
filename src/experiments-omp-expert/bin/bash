#!/bin/sh
# OMP's bash tool enters a second filesystem boundary. Prefer a nested bwrap
# mount namespace; use an unprivileged Landlock ruleset when the host AppArmor
# policy deliberately prevents nested bubblewrap.
case "${PATCHHOUND_AGENT_SHELL_BACKEND:-}" in
landlock)
  exec /usr/bin/python3 -I -B /app/bin/landlock_shell.py "$@"
  ;;
bubblewrap)
  exec /usr/bin/bwrap \
  --die-with-parent \
  --new-session \
  --unshare-pid \
  --unshare-ipc \
  --unshare-uts \
  --unshare-net \
  --proc /proc \
  --dev /dev \
  --ro-bind /usr /usr \
  --symlink usr/bin /bin \
  --symlink usr/lib /lib \
  --symlink usr/lib64 /lib64 \
  --symlink usr/sbin /sbin \
  --ro-bind /etc /etc \
  --dir /run \
  --dir /run/systemd \
  --dir /run/systemd/resolve \
  --ro-bind-try /run/systemd/resolve/stub-resolv.conf /run/systemd/resolve/stub-resolv.conf \
  --ro-bind /workspace/source /workspace/source \
  --bind /scratch /scratch \
  --tmpfs /tmp \
  --clearenv \
  --setenv HOME /scratch/home \
  --setenv XDG_CONFIG_HOME /scratch/xdg-config \
  --setenv XDG_CACHE_HOME /scratch/xdg-cache \
  --setenv XDG_DATA_HOME /scratch/xdg-data \
  --setenv TMPDIR /scratch/tmp \
  --setenv PATH /usr/bin:/bin \
  --setenv LANG C.UTF-8 \
  --setenv LC_ALL C.UTF-8 \
  --chdir /workspace/source \
  /bin/bash "$@"
  ;;
*)
  echo "patchhound Agent shell isolation backend is not configured" >&2
  exit 126
  ;;
esac
