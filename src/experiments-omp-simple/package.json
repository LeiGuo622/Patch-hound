{
  "name": "patchhound-experiments-omp-simple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun build sidecar/index.ts --outdir dist/sidecar --target bun --format esm --external omp-legacy-pi-modules --external @oh-my-pi/pi-natives",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "test": "bun test tests-ts",
    "lint": "bun x biome check sidecar tests-ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.0.11",
    "@oh-my-pi/pi-agent-core": "18.0.11",
    "@oh-my-pi/pi-ai": "18.0.11",
    "@oh-my-pi/omptype": "18.0.11",
    "@oh-my-pi/pi-utils": "18.0.11",
    "@oh-my-pi/pi-natives": "18.0.11"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "bun": "1.4.0",
    "typescript": "5.9.3"
  }
}
